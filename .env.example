# honeminer settings. Copy to .env and edit; a real environment variable always wins over .env.
# `python -m honeminer config` prints the effective values (secrets masked).

# --- Mode & network ---
HONEMINER_MODE=local                      # local | testnet | mainnet
SUBTENSOR_NETWORK=test                    # test | finney | ws://custom-endpoint
NETUID=                                   # Hone's netuid on that network; live modes refuse to start while empty
WALLET_NAME=default
WALLET_HOTKEY=default
AXON_PORT=8091
AXON_EXTERNAL_IP=
HONEMINER_ANTHROPIC_AUTHORIZATION=        # reference to Anthropic's written OK; required for testnet/mainnet

# --- Claude CLI & auth (credentials are used by the host gateway only, never inside the sandbox) ---
HONEMINER_CLAUDE_BIN=                     # native claude binary; auto-detected when empty
HONEMINER_MODEL=claude-opus-5-5
HONEMINER_EFFORT=high                     # low | medium | high | xhigh | max
HONEMINER_AUTH=oauth                      # oauth | api_key
CLAUDE_CODE_OAUTH_TOKEN=                  # from `claude setup-token`
ANTHROPIC_API_KEY=
HONEMINER_MAX_BUDGET_USD=                 # per task, api_key only; empty = no cap

# --- Concurrency ---
HONEMINER_SLOTS=1                         # concurrent solves; raise after measuring your plan's limits
HONEMINER_429_BACKOFF_S=30

# --- Clock (task budget) ---
HONEMINER_TASK_BUDGET_S=1200
HONEMINER_EXPIRY_MARGIN_S=45              # reply by expiry - 45 s (validator stops listening at about -30 s)
HONEMINER_RESERVE_FINAL_CHECK_S=30
HONEMINER_RESERVE_UPLOAD_S=20
HONEMINER_RESERVE_CLEANUP_S=5
HONEMINER_GATE_ROUND_S=60                 # expected Stop-gate time; a round starts only if it fits
HONEMINER_AUDIT_ROUND_MIN_LEFT=0.40       # one audit round when the gate passes with more than this left; 0 disables
HONEMINER_TIME_NOTICES=0.50,0.25,0.10     # fractions of the budget left at which Claude gets a time notice

# --- Trajectory (work log): deferred; live modes refuse while off ---
HONEMINER_TRAJECTORY=off
HONEMINER_TRAJECTORY_MAX_BYTES=           # empty = the offer's slot max_bytes
HONEMINER_TRAJECTORY_WARN_FRAC=0.70
HONEMINER_TRAJECTORY_STOP_FRAC=0.90

# --- Sandbox ---
HONEMINER_IMAGE=                          # empty = the release's pinned image; must be name@sha256:...
HONEMINER_AGENT_CPUS=4
HONEMINER_AGENT_MEMORY=8g
HONEMINER_AGENT_PIDS=4096
HONEMINER_AGENT_SCRATCH=8g
HONEMINER_STOP_HOOK_BLOCK_CAP=1000

# --- Archive ---
HONEMINER_RUNS_DIR=runs
HONEMINER_ARCHIVE_WORKSPACES=true
HONEMINER_ARCHIVE_MAX_GB=50
